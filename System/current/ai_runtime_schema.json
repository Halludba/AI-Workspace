{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Recursive AI Runtime Config",
  "type": "object",
  "required": [
    "runtime_name",
    "runtime_version",
    "authority_order",
    "module_types",
    "execution_policy",
    "preflight_policy",
    "host_contract",
    "modules",
    "decision_policy",
    "interaction_policy",
    "optimization_policy",
    "profiles",
    "provenance_policy",
    "release_version",
    "handoff_policy",
    "profile_performance_audit_policy",
    "workspace_policy",
    "pdf_styler_policy"
  ],
  "properties": {
    "runtime_name": {
      "type": "string",
      "minLength": 1
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "authority_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "module_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "core",
          "extension",
          "theme",
          "style"
        ]
      }
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "predictive_budget_per_user_directive",
        "required_execution_uses_predictive_budget",
        "predictive_handoff_after_budget",
        "execution_classes",
        "states"
      ],
      "properties": {
        "predictive_budget_per_user_directive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "required_execution_uses_predictive_budget": {
          "const": false
        },
        "predictive_handoff_after_budget": {
          "const": true
        },
        "execution_classes": {
          "type": "array",
          "items": {
            "enum": [
              "REQUIRED_EXECUTION",
              "PREDICTIVE_OPTIONAL",
              "USER_DECISION_REQUIRED"
            ]
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "preflight_policy": {
      "type": "object",
      "required": [
        "enabled",
        "auto_fix_only_when",
        "handoff_when",
        "limits"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "auto_fix_only_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoff_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "host_contract": {
      "type": "object",
      "required": [
        "modules_never_grant_capabilities",
        "reasoning_layer_required_for_semantic_mutation",
        "capability_degradation_policy"
      ],
      "properties": {
        "modules_never_grant_capabilities": {
          "const": true
        },
        "reasoning_layer_required_for_semantic_mutation": {
          "const": true
        },
        "capability_degradation_policy": {
          "type": "string"
        },
        "behavioral_determinism_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "enabled",
          "purpose",
          "trigger",
          "scope",
          "behavior",
          "required_capabilities",
          "side_effect_class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "core",
              "extension",
              "theme",
              "style"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "behavior": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "side_effect_class": {
            "enum": [
              "none",
              "local_reversible",
              "external_or_irreversible"
            ]
          },
          "state_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_policy": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "required": [
        "current_depth",
        "levels",
        "boundary"
      ],
      "properties": {
        "current_depth": {
          "enum": [
            "direct",
            "standard",
            "deep"
          ]
        },
        "levels": {
          "type": "object",
          "required": [
            "direct",
            "standard",
            "deep"
          ]
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interaction_policy": {
      "type": "object",
      "required": [
        "current_mode",
        "modes"
      ],
      "properties": {
        "current_mode": {
          "enum": [
            "bounded_autonomous",
            "collaborative",
            "educational_summary",
            "theme_studio"
          ]
        },
        "modes": {
          "type": "object",
          "required": [
            "bounded_autonomous",
            "collaborative",
            "educational_summary"
          ]
        }
      }
    },
    "optimization_policy": {
      "type": "object",
      "required": [
        "current_profile",
        "profiles",
        "hard_rule"
      ],
      "properties": {
        "current_profile": {
          "enum": [
            "speed",
            "balanced",
            "high_assurance",
            "creative_exploration"
          ]
        },
        "profiles": {
          "type": "object",
          "required": [
            "speed",
            "balanced",
            "high_assurance",
            "creative_exploration"
          ]
        },
        "hard_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": [
        "current_profile",
        "definitions"
      ],
      "properties": {
        "current_profile": {
          "type": "string",
          "minLength": 1
        },
        "definitions": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "provenance_policy": {
      "type": "object",
      "required": [
        "enabled",
        "capture_fields",
        "human_trace_artifact",
        "machine_trace_artifact",
        "history_integration",
        "changelog_integration",
        "privacy_boundary",
        "authority"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "purpose": {
          "type": "string"
        },
        "capture_fields": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "human_trace_artifact": {
          "type": "string",
          "minLength": 1
        },
        "machine_trace_artifact": {
          "type": "string",
          "minLength": 1
        },
        "history_integration": {
          "const": true
        },
        "changelog_integration": {
          "const": true
        },
        "privacy_boundary": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "evidence_only"
          ]
        }
      }
    },
    "release_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "handoff_policy": {
      "type": "object"
    },
    "modularity_policy": {
      "type": "object"
    },
    "theme_authoring_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "session_phases",
        "max_parallel_directions",
        "commit_requires_explicit_user_approval",
        "token_groups",
        "compile_target",
        "core_mutation_boundary"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "session_phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "max_parallel_directions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "commit_requires_explicit_user_approval": {
          "const": true
        },
        "preserve_session_rejections": {
          "type": "boolean"
        },
        "question_policy": {
          "type": "string"
        },
        "reference_policy": {
          "type": "string"
        },
        "iteration_policy": {
          "type": "string"
        },
        "token_groups": {
          "type": "object"
        },
        "unspecified_token_policy": {
          "type": "string"
        },
        "validation_policy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compile_target": {
          "type": "string"
        },
        "core_mutation_boundary": {
          "type": "string"
        },
        "post_approval_required_execution": {
          "type": "string"
        },
        "theme_reference_policy": {
          "type": "string"
        }
      }
    },
    "theme_reference_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "required_after_theme_compile",
        "output_pattern",
        "generator",
        "self_demonstrating",
        "fidelity_claim_rule",
        "non_pdf_properties",
        "verification",
        "authority_boundary"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "required_after_theme_compile": {
          "const": true
        },
        "output_pattern": {
          "type": "string"
        },
        "module_snapshot_pattern": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "self_demonstrating": {
          "const": true
        },
        "visual_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fidelity_claim_rule": {
          "type": "string"
        },
        "non_pdf_properties": {
          "type": "string"
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_boundary": {
          "type": "string"
        }
      }
    },
    "planning_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "plan_path",
        "schema_path",
        "authority_boundary",
        "decomposition_owner",
        "priority_order",
        "resume_triggers",
        "completion_rule",
        "handoff_rule"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "plan_path": {
          "type": "string"
        },
        "schema_path": {
          "type": "string"
        },
        "authority_boundary": {
          "type": "string"
        },
        "decomposition_owner": {
          "type": "string"
        },
        "macro_directive_behavior": {
          "type": "string"
        },
        "priority_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resume_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "part_resolution_rule": {
          "type": "string"
        },
        "completion_rule": {
          "type": "string"
        },
        "handoff_rule": {
          "type": "string"
        }
      }
    },
    "execution_capacity_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "estimate_before_heavy_execution",
        "estimation_boundary",
        "risk_signals",
        "segment_when",
        "checkpoint_location",
        "checkpoint_fields",
        "on_predicted_overrun",
        "resume_resolution_order",
        "new_unrelated_directive_policy"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "estimate_before_heavy_execution": {
          "type": "boolean"
        },
        "estimation_boundary": {
          "type": "string"
        },
        "risk_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "segment_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not_segment_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkpoint_location": {
          "type": "string"
        },
        "checkpoint_before_expensive_segment": {
          "type": "boolean"
        },
        "checkpoint_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_predicted_overrun": {
          "type": "string"
        },
        "resume_resolution_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_unrelated_directive_policy": {
          "type": "string"
        },
        "self_update_handoff": {
          "type": "string"
        }
      }
    },
    "secondary_review_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "optional",
        "recommended_profile",
        "relationship",
        "anti_redundancy_rule",
        "independence_boundary",
        "feedback_rule",
        "user_authority"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "recommended_profile": {
          "type": "string"
        },
        "relationship": {
          "type": "object"
        },
        "anti_redundancy_rule": {
          "type": "string"
        },
        "independence_boundary": {
          "type": "string"
        },
        "feedback_rule": {
          "type": "string"
        },
        "user_authority": {
          "type": "string"
        }
      }
    },
    "profile_performance_audit_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "advisory_only",
        "auto_integrate",
        "max_proposals",
        "session_phases",
        "report_schema",
        "rules"
      ],
      "properties": {
        "advisory_only": {
          "const": true
        },
        "auto_integrate": {
          "const": false
        },
        "max_proposals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "report_schema": {
          "const": "profile_audit_report_schema.json"
        }
      }
    },
    "workspace_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "mode",
        "front_door",
        "source_preference",
        "normal_iteration",
        "portable_export_policy",
        "access_boundary"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "mode": {
          "const": "PERSISTENT_PRIMARY"
        },
        "front_door": {
          "type": "string"
        },
        "source_preference": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "normal_iteration": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "portable_export_policy": {
          "type": "string"
        },
        "access_boundary": {
          "type": "string"
        }
      }
    },
    "pdf_styler_policy": {
      "type": "object",
      "required": [
        "policy_version",
        "enabled",
        "default_style_id",
        "style_registry_path",
        "style_schema_path",
        "selection_order",
        "trigger_rule",
        "content_priority",
        "verification",
        "authority_boundary"
      ]
    }
  }
}
