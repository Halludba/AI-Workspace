{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategic Project Plan",
  "type": "object",
  "required": [
    "plan_version",
    "project_name",
    "status",
    "master_objective",
    "direction_notes",
    "constraints",
    "parts",
    "current_part_id",
    "last_completed_part_id",
    "next_recommended_part_id",
    "resume_hint",
    "updated_utc"
  ],
  "properties": {
    "plan_version": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "AWAITING_DIRECTION",
        "ACTIVE",
        "PAUSED",
        "COMPLETED",
        "BLOCKED"
      ]
    },
    "master_objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "direction_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "part_number",
          "title",
          "raw_user_intent",
          "objective",
          "priority",
          "status",
          "dependencies",
          "acceptance_criteria",
          "completion_evidence",
          "next_actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "part_number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "raw_user_intent": {
            "type": "string"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "PENDING",
              "ACTIVE",
              "COMPLETED",
              "BLOCKED",
              "DEFERRED",
              "SUPERSEDED"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completion_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_reference": {
            "type": "string"
          }
        }
      }
    },
    "current_part_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_completed_part_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_recommended_part_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resume_hint": {
      "type": "string"
    },
    "updated_utc": {
      "type": "string"
    }
  }
}
