{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formats PDF System State",
  "type": "object",
  "required": [
    "system_name",
    "system_version",
    "artifact_root",
    "authority_order",
    "roles",
    "continuation_policy",
    "risk_policy",
    "convergence",
    "round_trip",
    "functions",
    "artifacts",
    "release"
  ],
  "properties": {
    "system_name": {
      "type": "string",
      "minLength": 1
    },
    "system_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_root": {
      "type": "string",
      "minLength": 1
    },
    "authority_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "object"
    },
    "continuation_policy": {
      "type": "object",
      "required": [
        "auto_continue_when",
        "stop_when"
      ],
      "properties": {
        "auto_continue_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk_policy": {
      "type": "object",
      "required": [
        "auto_eligible",
        "warn_or_block"
      ],
      "properties": {
        "auto_eligible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warn_or_block": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "convergence": {
      "type": "object",
      "required": [
        "max_passes",
        "detect_cycles",
        "primary_state_files"
      ],
      "properties": {
        "max_passes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "detect_cycles": {
          "type": "boolean"
        },
        "primary_state_files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "round_trip": {
      "type": "object",
      "required": [
        "canonical_machine_state",
        "generated_python_mirror",
        "supported_directions",
        "engine_self_modification"
      ],
      "properties": {
        "canonical_machine_state": {
          "type": "string"
        },
        "generated_python_mirror": {
          "type": "string"
        },
        "supported_directions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine_self_modification": {
          "const": false
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "deprecated",
              "blocked"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "classification",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "REQUIRED",
              "CONDITIONAL",
              "OPTIONAL"
            ]
          },
          "role": {
            "type": "string"
          },
          "generator": {
            "type": "string"
          },
          "bundle_folder": {
            "type": "string"
          },
          "include_in_bundle": {
            "type": "boolean"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "bundle_filename_pattern",
        "bundle_filename",
        "folder_policy",
        "ai_handoff_file_count"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "previous_version": {
          "type": "string"
        },
        "bundle_filename_pattern": {
          "type": "string"
        },
        "bundle_filename": {
          "type": "string"
        },
        "previous_bundle_path": {
          "type": "string"
        },
        "folder_policy": {
          "type": "string"
        },
        "ai_handoff_file_count": {
          "type": "integer",
          "const": 5
        }
      }
    },
    "modularity": {
      "type": "object"
    },
    "testing": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "preflight_required": {
          "type": "boolean"
        },
        "runner": {
          "type": "string"
        },
        "report": {
          "type": "string"
        },
        "test_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deterministic_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semantic_boundary": {
          "type": "string"
        }
      }
    }
  }
}
