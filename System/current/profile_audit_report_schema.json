{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "advisory_only",
    "target",
    "status",
    "evidence",
    "findings",
    "proposals",
    "limitations",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "advisory_only": {
      "const": true
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "session_id",
        "profile_version",
        "contract_snapshot",
        "completion_evidence_refs"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "contract_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "completion_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "locator",
          "summary",
          "availability",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE",
              "TRUNCATED"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimension",
          "requirement",
          "verdict",
          "claim_type",
          "evidence_refs",
          "rationale",
          "confidence",
          "attribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "enum": [
              "goal_result_fidelity",
              "interaction_efficiency",
              "path_quality",
              "unnecessary_friction",
              "missed_opportunities",
              "avoidable_failures",
              "convergence_opportunity",
              "reusable_policy_improvements"
            ]
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "MET",
              "PARTIAL",
              "MISSED",
              "NOT_APPLICABLE",
              "UNKNOWN"
            ]
          },
          "claim_type": {
            "enum": [
              "OBSERVATION",
              "INFERENCE",
              "HYPOTHESIS"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "attribution": {
            "enum": [
              "PROFILE_POLICY",
              "HOST_EXECUTION",
              "TOOL_PLATFORM",
              "MISSING_INPUT",
              "CHANGED_DIRECTION",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "finding_refs",
          "target",
          "before",
          "after",
          "lifecycle_candidate",
          "expected_benefit",
          "risk",
          "feasibility",
          "validation",
          "rollback",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "finding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle_candidate": {
            "enum": [
              "NEW",
              "MERGE",
              "REWRITE",
              "DELETE",
              "NO-OP",
              "DEFER"
            ]
          },
          "expected_benefit": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "feasibility": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "const": "PENDING_MAIN_HOST"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "scope_and_denominator",
          "evidence_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "scope_and_denominator": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
